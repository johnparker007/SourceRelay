<Window x:Class="SourceRelay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:SourceRelay.Models"
        xmlns:local="clr-namespace:SourceRelay"
        Title="SourceRelay" Height="780" Width="1400" MinHeight="600" MinWidth="1050"
        Background="#F3F5F7" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="3"/></Style>
        <Style TargetType="GroupBox"><Setter Property="Margin" Value="7"/><Setter Property="Padding" Value="8"/></Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#243447" Padding="14,10">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="SourceRelay" Foreground="White" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="A deliberately limited, local source-code handoff" Foreground="#C8D5E3"/></StackPanel>
                <Button Grid.Column="1" Content="Open Returned Bundle…" Click="OpenReturned_Click" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="#E1E8EF" Padding="12"><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/></Border>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="330"/><ColumnDefinition Width="3*" MinWidth="440"/><ColumnDefinition Width="1.5*" MinWidth="260"/></Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="3*"/><RowDefinition Height="2*"/></Grid.RowDefinitions>
              <GroupBox Header="Add source file or folder" Grid.Row="0">
                <StackPanel>
                  <DockPanel><Button DockPanel.Dock="Right" Content="Add" Click="AddSourcePath_Click"/><TextBox x:Name="SourcePathBox" Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" Padding="7" Margin="3" KeyDown="SourcePath_KeyDown" ToolTip="Paste an absolute file or directory path…"/></DockPanel>
                  <Button Content="Add Source Folder…" Click="ChooseFolder_Click" HorizontalAlignment="Left"/>
                </StackPanel>
              </GroupBox>
              <GroupBox Header="Sources" Grid.Row="1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <Button Content="Remove Selected Source Root" Click="RemoveSourceRoot_Click" HorizontalAlignment="Left"/>
                        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Margin="4" Padding="7" ToolTip="Search relative paths"/>
                    </StackPanel>
                    <TreeView x:Name="ProjectTree" ItemsSource="{Binding ProjectFiles}" BorderThickness="0">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <DockPanel LastChildFill="True">
                                    <CheckBox IsChecked="{Binding Included, Mode=TwoWay}" Click="SelectionChanged" VerticalAlignment="Center" ToolTip="Include in bundle"/>
                                    <TextBlock Text="{Binding Name}" Margin="5,0" VerticalAlignment="Center"/>
                                    <ComboBox SelectedValue="{Binding Mode, Mode=TwoWay}" SelectedValuePath="Tag" Width="88" Margin="3,0" Visibility="{Binding IsDirectory, Converter={x:Static local:BooleanBoxes.InverseConverter}}">
                                        <ComboBoxItem Content="Editable" Tag="{x:Static models:FileMode.Editable}"/><ComboBoxItem Content="Context" Tag="{x:Static models:FileMode.Context}"/>
                                    </ComboBox>
                                </DockPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                        <TreeView.ItemContainerStyle><Style TargetType="TreeViewItem"><Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/><Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/></Style></TreeView.ItemContainerStyle>
                    </TreeView>
                </DockPanel>
              </GroupBox>
              <GroupBox Grid.Row="2">
                <GroupBox.Header><TextBlock Text="{Binding SelectedFilesHeading}"/></GroupBox.Header>
                <ListBox ItemsSource="{Binding SelectedFileItems}" SelectionChanged="SelectedFile_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto">
                  <ListBox.ItemTemplate><DataTemplate>
                    <Grid Margin="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding DirectoryContext}" Foreground="#667" FontSize="11"/></StackPanel>
                      <ComboBox Grid.Column="1" SelectedValue="{Binding Mode, Mode=TwoWay}" SelectedValuePath="Tag" Margin="3"><ComboBoxItem Content="Editable" Tag="{x:Static models:FileMode.Editable}"/><ComboBoxItem Content="Context" Tag="{x:Static models:FileMode.Context}"/></ComboBox>
                      <Button Grid.Column="2" Content="×" Padding="8,2" ToolTip="Remove from bundle" Click="RemoveSelected_Click" Tag="{Binding}"/>
                    </Grid>
                  </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
              </GroupBox>
            </Grid>
            <GroupBox Header="Bundle and returned changes" Grid.Column="1">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="3*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding SelectionSummary}" FontWeight="SemiBold" Margin="4"/>
                        <WrapPanel><Button Content="Generate Bundle" Click="Generate_Click"/><Button Content="Open Output Folder" Click="OpenFolder_Click" IsEnabled="{Binding HasBundle}"/><Button Content="Dismiss Returned Bundle" Click="Dismiss_Click"/></WrapPanel>
                        <TextBlock Text="{Binding LastBundlePath}" TextWrapping="Wrap" Margin="4" Foreground="#346"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Changes}" SelectedItem="{Binding SelectedChange}" AutoGenerateColumns="False" IsReadOnly="False" Margin="3" CanUserAddRows="False">
                        <DataGrid.Columns><DataGridCheckBoxColumn Header="Apply" Binding="{Binding Apply}"/><DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="Classification" Binding="{Binding Classification}" Width="150" IsReadOnly="True"/><DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="2*" IsReadOnly="True"/></DataGrid.Columns>
                    </DataGrid>
                    <TextBox Grid.Row="2" Text="{Binding SelectedDiff, Mode=OneWay}" FontFamily="Consolas" FontSize="12" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="3"/>
                    <Button Grid.Row="3" Content="Apply Selected" Click="Apply_Click" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                </Grid>
            </GroupBox>
            <GroupBox Header="Activity and undo history" Grid.Column="2">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top"><Button Content="Undo" Click="Undo_Click"/><Button Content="Redo" Click="Redo_Click"/></WrapPanel>
                    <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <ListBox ItemsSource="{Binding Activity}" Margin="3"/>
                        <ListBox Grid.Row="1" ItemsSource="{Binding History}" Margin="3">
                            <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="2"><TextBlock><Run Text="{Binding TimestampUtc}"/><Run Text="  Applied bundle "/><Run Text="{Binding BundleId}"/></TextBlock><ItemsControl ItemsSource="{Binding Files}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding RelativePath}" Margin="12,0" Foreground="#556"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
